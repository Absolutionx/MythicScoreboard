-- luacheck configuration: tests/run.sh and CI run `luacheck MythicScoreboard`.
std = "lua51"
max_line_length = false
self = false
-- Event handlers and callbacks take arguments they may not use.
unused_args = false
exclude_files = { "MythicScoreboard/Libs/**" }
-- Written by the addon: saved variables and the slash command.
globals = {
    "MythicScoreboardDB", "MythicScoreboardAccountDB", "MythicScoreboardPortraitsDB",
    "SLASH_MYTHICSCOREBOARD1", "SLASH_MYTHICSCOREBOARD2", "SlashCmdList", "UISpecialFrames",
}
